{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Hall Monitor default capabilities",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-url",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "hall-server", "sidecar": true, "args": [] }]
    }
  ]
}

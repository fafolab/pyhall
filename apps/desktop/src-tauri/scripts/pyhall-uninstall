#!/bin/bash
# pyhall-uninstall — Hall Monitor uninstaller
# Copyright (c) 2026 pyhall.dev — All Rights Reserved.
# Installed at /usr/bin/pyhall-uninstall by the pyhall package.
#
# Default behavior: removes binaries and launchers only.
# User data (config, databases, logs) is PRESERVED unless --purge-data is passed.
#
# Usage:
#   pyhall-uninstall              # remove binaries/launchers, keep user data
#   pyhall-uninstall --purge-data # also remove user config/data after confirmation

set -e

BOLD="\033[1m"
RED="\033[0;31m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
CYAN="\033[0;36m"
RESET="\033[0m"

PURGE_DATA=0

for arg in "$@"; do
  case "$arg" in
    --purge-data) PURGE_DATA=1 ;;
    --help|-h)
      echo "Usage: pyhall-uninstall [--purge-data]"
      echo ""
      echo "  (no flags)    Remove binaries and launchers. Preserve user data."
      echo "  --purge-data  Also remove ~/.config/pyhall/ and ~/.local/share/pyhall/"
      echo "                after explicit confirmation."
      exit 0
      ;;
    *)
      echo -e "${RED}Unknown option: $arg${RESET}" >&2
      echo "Run 'pyhall-uninstall --help' for usage." >&2
      exit 1
      ;;
  esac
done

echo ""
echo -e "${BOLD}pyhall — Hall Monitor Uninstaller${RESET}"
echo "─────────────────────────────────────"
echo ""

# ─── Paths ────────────────────────────────────────────────────────────────────

APP_BINARY="/usr/bin/pyhall-desktop"
HALL_SERVER_BINARY="/usr/bin/hall-server"
UNINSTALLER_BINARY="/usr/bin/pyhall-uninstall"
DESKTOP_ENTRY="/usr/share/applications/pyhall.desktop"
USER_CONFIG="${HOME}/.config/pyhall"
USER_DATA="${HOME}/.local/share/pyhall"

# ─── Summary ──────────────────────────────────────────────────────────────────

echo -e "${BOLD}The following will be removed:${RESET}"
[ -f "$APP_BINARY" ]         && echo "  • App binary:       $APP_BINARY"
[ -f "$HALL_SERVER_BINARY" ] && echo "  • Hall Server:      $HALL_SERVER_BINARY"
[ -f "$DESKTOP_ENTRY" ]      && echo "  • Desktop entry:    $DESKTOP_ENTRY"
echo "  • This uninstaller: $UNINSTALLER_BINARY"
echo ""

echo -e "${CYAN}${BOLD}The following will be PRESERVED (your data):${RESET}"
echo "  • Config / settings:  $USER_CONFIG"
echo "  • Databases / logs:   $USER_DATA"
if [ "$PURGE_DATA" -eq 1 ]; then
  echo ""
  echo -e "${RED}${BOLD}--purge-data flag detected: data directories will also be removed after confirmation.${RESET}"
fi
echo ""

read -r -p "Remove Hall Monitor binaries and launcher? [y/N] " confirm
echo ""

if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
  echo "Uninstall cancelled."
  exit 0
fi

# ─── Remove binaries ──────────────────────────────────────────────────────────

REMOVED=0
SKIPPED=0

_remove() {
  local target="$1"
  local label="$2"
  if [ -e "$target" ]; then
    if sudo rm -f "$target" 2>/dev/null; then
      echo -e "${GREEN}  removed  ${RESET}$label ($target)"
      REMOVED=$((REMOVED + 1))
    else
      echo -e "${RED}  FAILED   ${RESET}$label ($target) — permission denied"
      SKIPPED=$((SKIPPED + 1))
    fi
  else
    echo -e "${YELLOW}  not found${RESET} $label ($target)"
  fi
}

echo -e "${BOLD}Removing binaries and launcher...${RESET}"
_remove "$APP_BINARY"         "app binary"
_remove "$HALL_SERVER_BINARY" "hall-server binary"
_remove "$DESKTOP_ENTRY"      "desktop entry"

# Remove any pyhall PATH export line added to ~/.bashrc or ~/.profile
for rc_file in "${HOME}/.bashrc" "${HOME}/.bash_profile" "${HOME}/.profile" "${HOME}/.zshrc"; do
  if [ -f "$rc_file" ] && grep -q "pyhall" "$rc_file" 2>/dev/null; then
    # Remove lines that export pyhall-related PATH entries
    if sed -i '/# pyhall PATH/d; /export PATH.*pyhall/d' "$rc_file" 2>/dev/null; then
      echo -e "${GREEN}  removed  ${RESET}pyhall PATH entry from $rc_file"
    fi
  fi
done

echo ""

# ─── Preserve user data (default) ─────────────────────────────────────────────

if [ "$PURGE_DATA" -eq 0 ]; then
  echo -e "${CYAN}${BOLD}User data preserved:${RESET}"
  [ -d "$USER_CONFIG" ] && echo -e "  ${CYAN}kept${RESET}  $USER_CONFIG"
  [ -d "$USER_DATA" ]   && echo -e "  ${CYAN}kept${RESET}  $USER_DATA"
  echo ""
  echo "  To remove your data in the future, run:"
  echo "    rm -rf \"$USER_CONFIG\" \"$USER_DATA\""
  echo "  Or reinstall and run:  pyhall-uninstall --purge-data"
  echo ""
fi

# ─── Purge data (opt-in) ──────────────────────────────────────────────────────

if [ "$PURGE_DATA" -eq 1 ]; then
  echo -e "${RED}${BOLD}Data purge requested.${RESET}"
  echo ""
  echo "This will permanently delete:"
  [ -d "$USER_CONFIG" ] && echo "  • $USER_CONFIG  (settings, profiles, logs, install receipt)"
  [ -d "$USER_DATA" ]   && echo "  • $USER_DATA  (databases)"
  echo ""
  echo -e "${RED}${BOLD}This cannot be undone.${RESET}"
  read -r -p "Type DELETE to confirm data removal: " purge_confirm
  echo ""

  if [ "$purge_confirm" = "DELETE" ]; then
    if [ -d "$USER_CONFIG" ]; then
      rm -rf "$USER_CONFIG"
      echo -e "${GREEN}  removed  ${RESET}$USER_CONFIG"
    else
      echo -e "${YELLOW}  not found${RESET} $USER_CONFIG"
    fi
    if [ -d "$USER_DATA" ]; then
      rm -rf "$USER_DATA"
      echo -e "${GREEN}  removed  ${RESET}$USER_DATA"
    else
      echo -e "${YELLOW}  not found${RESET} $USER_DATA"
    fi
    echo ""
  else
    echo -e "${YELLOW}Data purge cancelled — directories preserved.${RESET}"
    echo ""
  fi
fi

# ─── Remove this uninstaller last ─────────────────────────────────────────────

if [ -f "$UNINSTALLER_BINARY" ]; then
  sudo rm -f "$UNINSTALLER_BINARY" 2>/dev/null && \
    echo -e "${GREEN}  removed  ${RESET}this uninstaller ($UNINSTALLER_BINARY)" || \
    echo -e "${YELLOW}  could not remove ${RESET}$UNINSTALLER_BINARY (remove manually with: sudo rm $UNINSTALLER_BINARY)"
fi

echo ""
echo -e "${GREEN}${BOLD}Hall Monitor has been uninstalled.${RESET}"
if [ "$REMOVED" -gt 0 ]; then
  echo "  $REMOVED item(s) removed."
fi
echo "Visit https://pyhall.dev to reinstall."
echo ""
